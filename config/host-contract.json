    "LYCAON_CONFIG_ROOT",
    "LYCAON_DECIDE_BINARY",
    "LYCAON_DECIDE_DEVICE",
    "LYCAON_DECIDE_DISABLED",
    "LYCAON_DECIDE_HEADS",
    "LYCAON_DECIDE_MODEL_DIR",
