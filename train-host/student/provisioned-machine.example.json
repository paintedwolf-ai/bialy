{
  "host_repository": "https://github.com/paintedwolf-ai/paintedwolf-code.git",
  "host_commit": "",
  "bialy_repository": "https://github.com/paintedwolf-ai/bialy.git",
  "bialy_commit": "",
  "llama_repository": "https://github.com/ggml-org/llama.cpp.git",
  "llama_commit": "",
  "host_checkout": "/scratch/paintedwolf-training/src/host",
  "models": "/scratch/paintedwolf-training/models",
  "provisioning": {
    "provider": "scaleway",
    "profile": "training",
    "project": "",
    "zone": "fr-par-2",
    "registry": "/var/lib/paintedwolf-training/resources",
    "rental": "on-demand",
    "lifetime_hours": 72,
    "start_minutes": 15,
    "specification": {
      "type": "H100-1-80G",
      "image": "",
      "root_volume": "1TB",
      "gpu_memory_gib": 79,
      "memory_gib": 200,
      "disk_gib": 1000
    }
  },
  "machine": {
    "user": "root",
    "workspace": "/scratch/training",
    "uv": "/root/.local/bin/uv"
  }
}
