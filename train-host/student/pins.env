# Shared export and serving artifacts; student pins live in config/students.json.
# LLAMA_COMMIT is the commit SERVER_IMAGE was built from: the export and every evaluation
# server check the build a server reports against it.
LLAMA_COMMIT=1d88cb05f1a257f90741538ca3aca6c1b015c6d3
SERVER_IMAGE=ghcr.io/ggml-org/llama.cpp@sha256:31b39eacce2bab5fde9286ec3980ed5548a3987644e94da0d0c2092f93313538
# The Vast.ai CLI the controller drives; `bialy.student_host` refuses any other release.
VASTAI_CLI_VERSION=1.11.0
HOST_URL=https://github.com/paintedwolf-ai/paintedwolf-code
