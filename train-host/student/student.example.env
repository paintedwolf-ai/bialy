# Copy to student.local.env, which git ignores, and fill in this deployment.
# Hosts are SSH aliases from your own ~/.ssh/config; the alias resolves the
# address, user, and key, so none of them appear here or in any output.

# The training host: holds the factory's runs, the student checkpoint, and the
# merged and converted results.
STUDENT_TRAIN_HOST=bialy-train
# Working root on the training host.
STUDENT_ROOT=/scratch

# Branches the training host checks out until the custom-model work lands.
HOST_REF=main
BIALY_REF=main

# Workspace held out of the pilot's training rows, so the holdout split is nonempty.
STUDENT_PILOT_HOLDOUT=vue-vite

# An optional external teacher served on the training host for qualification.
# Leave TEACHER_FILE empty to skip it.
TEACHER_REPO=
TEACHER_REV=
TEACHER_FILE=
TEACHER_SHA256=
# Loopback port a restricted tunnel key may forward to; empty skips the key.
TUNNEL_PORT=

# The rented SFT host. The scw CLI profile holds the account, project, and SSH key.
SCW_PROFILE=default
SCW_ZONE=fr-par-2
SCW_TYPE=H100-1-80G
SCW_IMAGE=ubuntu_noble_gpu_os_13_nvidia
SCW_ROOT_VOLUME=sbs:200GB
# Used only to print the cost estimate when the server is deleted.
SCW_HOURLY_EUR=2.8665
